{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saliftankoano/pierre-build-program/schemas/story.schema.json",
  "title": "Pierre Build Program work item",
  "type": "object",
  "required": [
    "id",
    "type",
    "priority",
    "epic",
    "title",
    "persona",
    "outcome",
    "context",
    "acceptanceCriteria",
    "expectations",
    "dependencies",
    "nonGoals",
    "definitionOfDone",
    "evidence",
    "concepts"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SWAI-[0-9]{3}$" },
    "type": {
      "enum": ["kickoff", "story", "bug", "spike", "chore", "change", "review", "lab"]
    },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "epic": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 5 },
    "persona": { "type": "string", "minLength": 2 },
    "outcome": { "type": "string", "minLength": 10 },
    "context": { "type": "string", "minLength": 20 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "designRefs": { "type": "array", "items": { "type": "string" } },
    "dataContract": { "type": "string" },
    "expectations": {
      "type": "object",
      "required": ["security", "privacy", "accessibility", "analytics"],
      "properties": {
        "security": { "type": "string" },
        "privacy": { "type": "string" },
        "accessibility": { "type": "string" },
        "analytics": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "definitionOfDone": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "seededBug": { "type": "string" },
    "labContract": { "$ref": "lab.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "lab" } }, "required": ["type"] },
      "then": { "required": ["labContract"] },
      "else": { "not": { "required": ["labContract"] } }
    }
  ],
  "additionalProperties": false
}
