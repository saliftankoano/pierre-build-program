{
  "name": "pierre-build-program",
  "version": "1.0.0",
  "private": true,
  "description": "Visual agency-style program for learning to plan and ship Next.js products with Codex",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "validate": "node scripts/validate-curriculum.mjs && node scripts/validate-labs.mjs && node scripts/validate-issue-forms.mjs && node scripts/validate-evidence.mjs && node scripts/scan-secrets.mjs",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm test",
    "agency:bootstrap": "node scripts/bootstrap-agency.mjs",
    "agency:next": "node scripts/release-next-packet.mjs",
    "agency:mission-control": "node scripts/mission-control.mjs",
    "project:new": "node scripts/new-project.mjs",
    "labs:scaffold": "node scripts/scaffold-labs.mjs",
    "lab": "node scripts/lab-cli.mjs start",
    "lab:test": "node scripts/lab-cli.mjs test",
    "lab:hint": "node scripts/lab-cli.mjs hint"
  },
  "license": "MIT"
}
